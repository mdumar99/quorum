# Local environment and caches: rebuilt inside the image, never copied in.
# `**/` matters: a pattern without it only matches at the root of the build context, so the
# __pycache__ folders under app/ and migrations/ would still be copied into the image.
.venv/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.ruff_cache/

# Tests run in CI, not in the production image
tests/

# Secrets must never end up in an image layer
.env
.env.*

# Next.js reads env files from apps/web/ only, NOT the repo root.
# Native dev: copy this file to apps/web/.env.local, then `npm run dev`.
# Docker (P0-2): Compose sets these directly; the container never reads .env.local.

# Server-side only: where the Next.js *server* reaches the API.
#   Native: http://localhost:8000
#   Docker: http://api:8000   (set by Compose, not by this file)
API_URL=http://localhost:8000

# Browser-side. RESERVED, unused in Phase 0 (no browser-side fetches).
# NEXT_PUBLIC_* values are baked into the JavaScript bundle at BUILD time
# and are visible to anyone who opens the page. Never put secrets here.
# NEXT_PUBLIC_API_URL=http://localhost:8000
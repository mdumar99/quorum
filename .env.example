# --- Postgres (used by the postgres container and by the API) ---
POSTGRES_USER=quorum
POSTGRES_PASSWORD=change-me
POSTGRES_DB=quorum

# Host port Postgres is published on. Change it if 5432 is already taken
# (e.g. by a PostgreSQL installed directly on Windows).
# If you change it, change the port in DATABASE_URL and OWNER_DATABASE_URL below to match.
POSTGRES_HOST_PORT=5432

# --- Application roles (created by the one-shot `bootstrap` service; see ADR-0002) ---
# Passwords for the owner role (migrations) and the app role (the API). The role names are
# fixed (quorum_owner, quorum_app). Set both before `docker compose up`.
# A role that already exists keeps its old password: changing these does not change it.
# Both passwords go into connection URLs without encoding, so use letters and digits only.
# A password with @ / % or $ breaks the URL (for example @ makes the host read as "ss@postgres"),
# and the API then cannot connect: /health reports db "error".
QUORUM_OWNER_PASSWORD=change-me
QUORUM_APP_PASSWORD=change-me

# --- API connection URLs (native run: localhost via published ports) ---
# In Docker (P0-2), Compose builds DATABASE_URL itself, from QUORUM_APP_PASSWORD.
# DATABASE_URL is the app role: its password must be the same as QUORUM_APP_PASSWORD.
DATABASE_URL=postgresql://quorum_app:change-me@localhost:5432/quorum
# The owner role, for migrations and tests only. The API never reads it, and Compose does not
# pass it to the api service (Compose builds the migrate service's own OWNER_DATABASE_URL from
# QUORUM_OWNER_PASSWORD). Its password must be the same as QUORUM_OWNER_PASSWORD.
OWNER_DATABASE_URL=postgresql://quorum_owner:change-me@localhost:5432/quorum
REDIS_URL=redis://localhost:6379/0

# --- API ---
# Log verbosity: DEBUG, INFO, WARNING or ERROR. Defaults to INFO if unset.
LOG_LEVEL=INFO

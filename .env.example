# --- Postgres (used by the postgres container and by the API) ---
POSTGRES_USER=quorum
POSTGRES_PASSWORD=change-me
POSTGRES_DB=quorum

# Host port Postgres is published on. Change it if 5432 is already taken
# (e.g. by a PostgreSQL installed directly on Windows).
# If you change it, change the port in DATABASE_URL below to match.
POSTGRES_HOST_PORT=5432

# --- Application roles (created by the one-shot `bootstrap` service; see ADR-0002) ---
# Passwords for the owner role (migrations) and the app role (the API). The role names are
# fixed (quorum_owner, quorum_app). Set both before `docker compose up`.
# A role that already exists keeps its old password: changing these does not change it.
QUORUM_OWNER_PASSWORD=change-me
QUORUM_APP_PASSWORD=change-me

# --- API connection URLs (native run: localhost via published ports) ---
# In Docker (P0-2), Compose overrides these with service names.
DATABASE_URL=postgresql://quorum:change-me@localhost:5432/quorum
REDIS_URL=redis://localhost:6379/0

# --- API ---
# Log verbosity: DEBUG, INFO, WARNING or ERROR. Defaults to INFO if unset.
LOG_LEVEL=INFO
